  InputLines:
    - '// @input SceneObject ringPivot {"hint":"Child SceneObject that carries the eased ring yaw. Cards are parented under it."}'
    - "// @input AssignableType_1[] cards {\"hint\":\"The 12 card SceneObjects' OrbitCardUI components, in slot order (any order — sorted by urgency at runtime).\"}"
    - "// @input AssignableType_2 counter {\"hint\":\"The '+N more' counter chip.\"}"
    - '// @input AssignableType_3 emptyState {"hint":"The calm completion state shown when the queue is exhausted."}'
    - '// @ui {"widget":"separator"}'
    - '// @input float radius = 70 {"hint":"Arc radius from the user, in cm.", "widget":"slider", "min":50, "max":100, "step":1}'
    - "// @input string nowIso = \"2026-08-28T08:05:00Z\" {\"hint\":\"Reference 'now' as ISO-8601 UTC — drives the relative-time labels. Defaults to just after the dataset's generation time.\"}"
    - '// @ui {"widget":"separator"}'
    - '// @input float recentreThresholdDeg = 45 {"hint":"Head-turn past this many degrees (and held) before the ring re-centres.", "widget":"slider", "min":20, "max":90, "step":1}'
    - '// @input float holdSeconds = 0.5 {"hint":"Seconds the head must stay past the threshold before the re-centre begins.", "widget":"slider", "min":0.1, "max":2, "step":0.1}'
    - '// @input float easeSeconds = 0.6 {"hint":"Seconds the ring takes to ease into the new orientation.", "widget":"slider", "min":0.2, "max":1.5, "step":0.1}'
    - "// @input float verticalFollow = 0.08 {\"hint\":\"How quickly the ring's height tracks the user's (0 = frozen, 1 = instant). Keeps cards at eye level without head-bob.\", \"widget\":\"slider\", \"min\":0.02, \"max\":1, \"step\":0.01}"
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Card theme"}'
    - '// @input vec4 surfaceFill = {0.13,0.145,0.17,0.9} {"hint":"Card surface fill. Low luminance for the additive display — a black fill would be invisible on device.", "widget":"color"}'
    - '// @input vec4 borderColor = {0.72,0.74,0.8,0.9} {"hint":"Card border colour — the bright edge that actually defines the card against the world.", "widget":"color"}'
    - '// @input float borderSize = 0.15 {"hint":"Card border thickness in cm (~1.5 mm).", "widget":"slider", "min":0.05, "max":0.4, "step":0.01}'
    - '// @input float cornerRadius = 1.2 {"hint":"Card corner radius in cm.", "widget":"slider", "min":0.4, "max":3, "step":0.1}'
    - '// @ui {"widget":"group_end"}'
